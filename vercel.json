{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd Front && pnpm install && pnpm run build",
  "outputDirectory": "Front/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
