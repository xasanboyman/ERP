{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd Front && pnpm install --force",
  "buildCommand": "cd Front && NODE_OPTIONS='--max-old-space-size=4096' pnpm run build",
  "outputDirectory": "Front/dist",
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
