{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://127.0.0.1:8000/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
